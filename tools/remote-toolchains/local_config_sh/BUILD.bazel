load("@bazel_tools//tools/sh:sh_toolchain.bzl", "sh_toolchain")

sh_toolchain(
    name = "local_sh",
    path = "/usr/bin/bash",  # Use container path, not NixOS path
    visibility = ["//visibility:public"],
)

toolchain(
    name = "sh_toolchain",
    toolchain = ":local_sh",
    toolchain_type = "@bazel_tools//tools/sh:toolchain_type",
)