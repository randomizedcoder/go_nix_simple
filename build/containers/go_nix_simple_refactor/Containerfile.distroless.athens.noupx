# Variant: Base=gcr.io/distroless/static-debian12, Cache=athens, UPX=false

# --- Global ARGs ---
# These are available throughout the build
ARG GO_VERSION=1.24.2
ARG MYPATH=. # Default context path
ARG COMMIT=unknown
ARG DATE=unknown
ARG VERSION=unknown
ARG TARGETOS=linux # Default target OS
ARG TARGETARCH=amd64 # Default target ARCH
ARG TARGETPLATFORM=linux/amd64 # Usually set by Docker automatically

# --- Build Stage ---
FROM --platform=${BUILDPLATFORM} golang:${GO_VERSION} AS build

# ARGs repeated here are only necessary if you need to use them
# *within* this stage and want to ensure they override any global defaults
# specifically for this stage (usually not needed if defined globally).
# ARG COMMIT
# ARG DATE
# ARG VERSION

# Set working directory within the build stage
WORKDIR /go/src

# Copy application source code
# Consider being more specific if possible, e.g.:
# COPY go.mod go.sum ./
# COPY cmd/ ./cmd/
# COPY internal/ ./internal/ # If you have internal packages
# COPY VERSION ./
COPY . .

# Optional: Copy CA certs from the builder image itself for later use in scratch
RUN cp /etc/ssl/certs/ca-certificates.crt /ca-certificates.crt

# Optional: Echo build args for debugging
RUN echo "Building with MYPATH:${MYPATH} COMMIT:${COMMIT} DATE:${DATE} VERSION:${VERSION} TARGETPLATFORM:${TARGETPLATFORM}"

# --- Go Build Step ---
# This command is generated by the Go program based on CachingMode
RUN GOPROXY=http://localhost:8888,https://proxy.golang.org,direct \
    CGO_ENABLED=0 go build \
    -trimpath \
    -tags=netgo,osusergo \
    -ldflags="-s -w" \
    -o /go/bin/go_nix_simple \
    ./cmd/go_nix_simple/go_nix_simple.go
# --- End Go Build Step ---

# --- UPX Stage (Conditional) ---

# --- End UPX Stage ---

# --- Arrange Stage ---
# Consolidates artifacts needed for the final image
FROM scratch AS arrange

# Copy the executable (either original or UPX'd)

COPY --from=build --chmod=544 /go/bin/go_nix_simple /


# Copy the VERSION file
COPY --from=build --chmod=444 /go/src/VERSION /

# Copy CA certs only if the final base image is scratch

# --- End Arrange Stage ---


# --- Final Stage ---
FROM gcr.io/distroless/static-debian12
COPY --from=arrange / /
USER 9999:9999
EXPOSE 9108
ENTRYPOINT ["/go_nix_simple"]
# --- End Final Stage ---
